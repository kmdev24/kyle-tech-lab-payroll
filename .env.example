# TiDB Cloud Serverless (MySQL). Copy the "Prisma" connection string from the TiDB console.
# sslaccept=strict is required by TiDB Serverless.
DATABASE_URL="mysql://<USER>.root:<PASSWORD>@gateway01.<region>.prod.aws.tidbcloud.com:4000/payroll?sslaccept=strict"

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Resend (https://resend.com). FROM must be on a domain you verified in Resend
# (onboarding@resend.dev works for testing, but only sends to your own Resend account email).
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="KYLE TECH LAB <payroll@yourdomain.com>"

# Seed-only values (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="kyle@example.com"
SEED_ADMIN_PASSWORD="change-me-admin"
SEED_VIEWER_EMAIL="mom@example.com"
SEED_VIEWER_PASSWORD="change-me-mom"
SEED_PDF_PASSWORD="01011970"
