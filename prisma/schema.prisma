// KYLE TECH LAB payroll - TiDB Cloud Serverless (MySQL wire protocol)
// DATABASE_URL must end with ?sslaccept=strict (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

enum EntryKind {
  CONTRACT
  INCENTIVE
}

enum CutoffStatus {
  PENDING
  RECEIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One CONTRACT row per Saturday-to-Friday week, plus any one-off INCENTIVE rows.
model Cutoff {
  id              String       @id @default(cuid())
  kind            EntryKind    @default(CONTRACT)
  periodStart     DateTime     @db.Date // Saturday
  periodEnd       DateTime     @db.Date // Friday
  payoutDate      DateTime     @db.Date // following Wednesday
  hoursWorked     Decimal      @db.Decimal(8, 2)
  // Admin-only figures. Never selected for the VIEWER role.
  baseRate        Decimal      @default(30.00) @db.Decimal(8, 2)
  // Actual USD earned as shown by the client platform (its hours are rounded,
  // so this can differ slightly from hours x $30). Overrides hours x baseRate.
  earnedUsd       Decimal?     @db.Decimal(10, 2)
  // The only rate the VIEWER role can read ($9.00 = 30% of $30.00).
  viewerRate      Decimal      @default(9.00) @db.Decimal(8, 2)
  // Mom's 30% of earnedUsd, precomputed on save so viewer queries never read earnedUsd.
  viewerEarnedUsd Decimal?     @db.Decimal(10, 2)
  status          CutoffStatus @default(PENDING)
  // Mid-market USD->PHP for the payout date. Locked automatically once the payout
  // date's rate is published (or when marked RECEIVED); null means "use live rate".
  fxRate          Decimal?     @db.Decimal(12, 6)
  // Exact rate from the Stripe receipt (fee already included). Overrides fxRate.
  stripeRate      Decimal?     @db.Decimal(12, 6)
  fxFeePercent    Decimal?     @db.Decimal(5, 2)
  receivedAt      DateTime?
  emailSentAt     DateTime?
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([periodStart])
  @@index([status])
}

// Singleton row (id = 1)
model PaymentSettings {
  id               Int      @id @default(1)
  bankName         String   @default("GoTyme")
  accountName      String   @default("")
  accountNumber    String   @default("")
  recipientEmail   String   @default("")
  pdfPassword      String   @default("")
  // Stripe FX conversion fee/margin deducted from the live rate (1.0 = 1.0%).
  // Default calibrated from a real Mercor/Stripe payout: 62.3271 vs ~62.93 mid on Oct 14, 2026.
  fxFeePercent     Decimal  @default(1.00) @db.Decimal(5, 2)
  fxFeeCalibrated  Boolean  @default(false)
  // Legacy single goal; superseded by SavingsGoal (used once to seed "House Fund").
  // Days between Mercor sending the payout and it arriving in Kyle's bank.
  // That arrival day is also when Mom's salary is sent.
  arrivalDays      Int      @default(5)
  houseFundGoalPhp Decimal  @default(3000000) @db.Decimal(14, 2)
  goalsInitialized Boolean  @default(false)
  // Optional: the static QR Ph / InstaPay string from Mom's own "Receive money" QR.
  // When present, the payout QR is generated from it with the exact amount filled in.
  qrPhPayload      String?  @db.Text
  updatedAt        DateTime @updatedAt
}

// Admin-only savings goals. Kyle's received PHP share fills them in priority order.
model SavingsGoal {
  id          String   @id @default(cuid())
  name        String
  targetPhp   Decimal  @db.Decimal(14, 2)
  // Money already saved elsewhere before using the app.
  startingPhp Decimal  @default(0) @db.Decimal(14, 2)
  // Lower number = filled first.
  priority    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
